# Claude review (optional). The server holds the credentials; the browser never sees them.
# With a key set, `npm run dev` / `npm start` add Claude's review on top of the local engine.
ANTHROPIC_API_KEY=

# on  = force the Claude path on (e.g. you use an `ant auth login` profile instead of a key)
# off = always use the local heuristic engine only
# CONTENTGUARD_LLM=

# Model and effort used for the review (defaults shown).
# CONTENTGUARD_MODEL=claude-opus-5-5
# CONTENTGUARD_EFFORT=medium

# Point the browser at an external analysis backend instead of the bundled /api routes.
# VITE_ANALYSIS_API_URL=
